# Copy to .env and fill in locally. NEVER commit the filled-in file: .env is
# gitignored. These are variable names and placeholders only, never real values.
#
# In production these are set in the hosting dashboard's environment settings,
# not in a file.

# ---------------------------------------------------------------- database
# The PostgreSQL connection the backend uses.
DATABASE_URL=jdbc:postgresql://HOST/DATABASE?sslmode=require
DATABASE_USERNAME=replace-with-database-user
DATABASE_PASSWORD=replace-with-database-password

# ---------------------------------------------------------------- tokens
# Signing key for access tokens. Must be at least 32 characters: the application
# refuses to start with anything shorter. Generate a fresh random value, e.g.
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# ---------------------------------------------------------------- first admin
# Used only to create the very first administrator, when the database has none.
# Once an administrator exists these are ignored, and an existing account is
# never promoted. Leave them unset on an instance that already has one.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-admin-password

# Emergency only: set this to the administrator USERNAME to reset that account's
# password to ADMIN_PASSWORD at the next start. Remove both variables once done.
# Leave unset in normal operation.
# ADMIN_PASSWORD_RESET=

# ---------------------------------------------------------------- browser
# Exact origins allowed to call the API from a browser, comma separated.
APP_CORS_ALLOWED_ORIGINS=https://booknestx.vercel.app,http://localhost:5173

# ---------------------------------------------------------------- local MySQL
# Only needed for the optional `mysql` profile.
MYSQL_URL=jdbc:mysql://localhost:3306/library_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
MYSQL_USERNAME=replace-with-mysql-user
MYSQL_PASSWORD=replace-with-mysql-password
